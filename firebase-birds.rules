// Add this block INSIDE match /databases/{database}/documents in EXISTING rules.
// Do not replace your English site's rules with this fragment.
match /profiles/{uid}/birdProgress/{cardId} {
  allow read: if request.auth != null;
  allow create, update: if request.auth != null
    && request.auth.uid == uid
    && cardId.matches('^[a-z0-9-]+__(photo|audio|names-(en|latin|pl))$')
    && request.resource.data.keys().hasAll(['level','interval','ease','due','reps','lapses','updatedAt'])
    && request.resource.data.keys().hasOnly(['level','interval','ease','due','reps','lapses','updatedAt'])
    && request.resource.data.level is int
    && request.resource.data.level >= 0 && request.resource.data.level <= 10
    && request.resource.data.interval is number
    && request.resource.data.interval >= 0 && request.resource.data.interval <= 365
    && request.resource.data.ease is number
    && request.resource.data.ease >= 1.3 && request.resource.data.ease <= 3.5
    && request.resource.data.due is number && request.resource.data.due >= 0
    && request.resource.data.reps is int && request.resource.data.reps >= 0
    && request.resource.data.lapses is int && request.resource.data.lapses >= 0
    && request.resource.data.updatedAt is number && request.resource.data.updatedAt >= 0;
  allow delete: if request.auth != null && request.auth.uid == uid;
}
